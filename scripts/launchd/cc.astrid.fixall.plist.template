<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Scheduled /fixall — one unattended pass at :00 and :30.

  A TEMPLATE, not an installable plist. Install it with:

    ./scripts/launchd/install.sh cc.astrid.fixall

  which fills in __REPO_ROOT__ and __HOME__ from wherever this checkout actually lives,
  then bootstraps the job. Re-run it after moving the checkout; no path is committed, so
  there is nothing to hand-edit and nothing to rot. Stop it with:

    launchctl bootout gui/$(id -u)/cc.astrid.fixall

  KEEP THE CHECKOUT OUT OF TCC-PROTECTED DIRECTORIES (~/Documents, ~/Desktop,
  ~/Downloads). From one of those, a launchd agent reading the repo blocks pending
  consent rather than failing, and the job hangs in `state = running` with an empty log
  while launchd swallows every later tick. See .claude/commands/fixall.md.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cc.astrid.fixall</string>

    <!--
      node, not zsh: a zsh launched straight by launchd has no TCC access to protected
      locations, and git dies before the run starts. The shim also self-locates the repo,
      which is what lets this template name only __REPO_ROOT__. Keep it. See the shim.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>__REPO_ROOT__/scripts/run-fixall-loop.mjs</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!--
          An unattended run cannot answer a permission prompt: a prompt in `claude -p`
          is a denial, and the run stalls on its first build. This is the same mode the
          astrid-web weekly hygiene review has run under since 2026-09-06.

          It is set HERE rather than defaulted in fixall-loop.sh on purpose, so that
          granting it is a visible line in the file you install, and so `npm run
          fixall:loop` by hand still prompts like an ordinary session.
        -->
        <key>FIXALL_PERMISSION_MODE</key>
        <string>bypassPermissions</string>
    </dict>

    <!--
      :00 and :30, deliberately NOT StartInterval 1800. Fixed clock minutes interleave
      with the Copilot workflow in .github/workflows/fixall.yml, which runs at :15 and
      :45 against the same board. Two harnesses claiming the same queue at the same
      instant is a race the claim endpoint answers with a 409; not racing is better.

      If the Mac is asleep, launchd runs it once on wake rather than replaying every
      missed tick.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/astrid-fixall.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/astrid-fixall.log</string>
</dict>
</plist>
