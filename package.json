{
  "name": "astrid-ios",
  "version": "1.0.0",
  "description": "Astrid iOS App - Task management with AI assistance",
  "private": true,
  "scripts": {
    "predeploy": "./scripts/predeploy.sh",
    "predeploy:full": "./scripts/predeploy.sh --full",
    "predeploy:quick": "./scripts/predeploy.sh --quick",
    "test": "./scripts/run-tests.sh",
    "test:ui": "./scripts/run-tests.sh --ui --no-unit",
    "test:all": "./scripts/run-tests.sh --ui",
    "check:localizations": "./scripts/check-localizations.sh",
    "check:brand": "./scripts/check-brand.sh",
    "check:brands": "./scripts/check-brands.sh",
    "apply:brand": "./scripts/apply-brand.sh",
    "build": "xcodebuild build -scheme 'Astrid App' -destination 'platform=iOS Simulator,name=iPhone 17' -quiet",
    "build:verbose": "xcodebuild build -scheme 'Astrid App' -destination 'platform=iOS Simulator,name=iPhone 17'",
    "audit:dependencies": "npm audit --omit=dev",
    "package:mac": "./scripts/package-mac.sh",
    "release:ios": "./scripts/appstore-release.sh ios",
    "release:ios:upload": "./scripts/appstore-release.sh ios --upload",
    "release:mac": "./scripts/appstore-release.sh mac",
    "release:mac:upload": "./scripts/appstore-release.sh mac --upload"
  },
  "keywords": [
    "ios",
    "swift",
    "task-management",
    "ai"
  ],
  "author": "Graceful Tools",
  "license": "UNLICENSED"
}
