<?xml version="1.0" encoding="UTF-8"?>
<!-- Entitlements for the DIRECT-DOWNLOAD (Developer ID) Mac build.
     Identical to Astrid Mac.entitlements minus com.apple.developer.applesignin: Apple does not
     issue that entitlement in Developer ID provisioning profiles, and the export fails with it
     present. MacSignInOptions hides the Apple button at runtime when the entitlement is absent,
     so the DMG offers Passkey / Google / email instead. TestFlight and App Store builds keep the
     full entitlements file and the Apple button. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:astrid.cc</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
